# ===== LangChainRAG 环境变量示例 =====
# 复制本文件为 .env（在同一目录），填上真实值再启动后端。
# .env 已被 git 忽略，不会提交，密钥只在你自己机器上。

# 必填：阿里云百炼(DashScope) API Key——问答和向量化都靠它
DASHSCOPE_API_KEY=

# 必填：登录令牌签名密钥，随便一长串随机字符，别外传
SECRET_KEY=

# ===== 以下可选 =====

# 想临时回到 SQLite（不想开 Docker MySQL）时，取消注释并填本机绝对路径：
# DB_URL=sqlite:///D:/你的路径/LangChainRAG/langchain_rag.db

# MySQL 连接参数：默认值和 docker-compose.yml 一致，本地开发不用填；
# 部署到别的机器时再覆盖成真实地址/账号/密码
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=rag
# DB_PASSWORD=rag_dev_pass
# DB_NAME=langchainrag
